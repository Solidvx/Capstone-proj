# Debian multiarch target packages live under /usr/lib/aarch64-linux-gnu.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_CROSSCOMPILING_EMULATOR /usr/bin/qemu-aarch64;-L;/ CACHE STRING "ARM64 user-mode emulator")
set(CMAKE_FIND_ROOT_PATH /usr/aarch64-linux-gnu /)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(OPENSSL_CRYPTO_LIBRARY /usr/lib/aarch64-linux-gnu/libcrypto.so CACHE FILEPATH "ARM64 crypto library")
set(OPENSSL_INCLUDE_DIR /usr/include CACHE PATH "Multiarch OpenSSL headers")
set(GTest_DIR /usr/lib/aarch64-linux-gnu/cmake/GTest CACHE PATH "ARM64 GoogleTest")
set(Qt6_DIR /usr/lib/aarch64-linux-gnu/cmake/Qt6 CACHE PATH "ARM64 Qt")
set(QT_HOST_PATH /usr CACHE PATH "Matching native Debian Qt tools")
set(QT_HOST_PATH_CMAKE_DIR /usr/lib/x86_64-linux-gnu/cmake CACHE PATH "Native Qt tool packages")
