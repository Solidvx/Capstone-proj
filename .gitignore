dist/
*.egg

# pytest 캐시
.pytest_cache/
.coverage
htmlcov/

# --- IDS 대용량 파일 (gitignore 핵심) ---
# 학습된 Isolation Forest 모델 (수십~수백 MB)
security/ids/models/
security/ids/data/

# 실험 결과 원본 CSV (수집 CAN 트래픽, 수GB 가능)
security/ids/logs/
security/attack_simulators/logs/

# 단, 재현 방법 문서와 요약 수치는 커밋 대상
# security/ids/how_to_train.md  ← 커밋 O
# security/ids/results_summary.csv  ← 커밋 O (경량 요약만)


